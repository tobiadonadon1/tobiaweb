# The shop (The 98¢ Trade). Copy to .env.local for local use, and set the same
# names in Vercel → Project → Settings → Environment Variables. docs/shop.md
# walks through where each value comes from. /api/shop/health checks them.

# Stripe → Developers → API keys. sk_test_… while testing, sk_live_… to sell.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=
# The delivery email goes out from tobia10donadon@gmail.com through Gmail.
# A Google App Password (myaccount.google.com/apppasswords), not the account password.
GMAIL_APP_PASSWORD=
# Fallback only, used when GMAIL_APP_PASSWORD is empty: Resend → API Keys (re_…).
RESEND_API_KEY=
# Decrypts private/*.enc. Generated by `npm run seal`; must match the one used to seal.
SHOP_FILE_KEY=

# Optional. The sending address, default tobia10donadon@gmail.com (SHOP_EMAIL in lib/shop/products.ts).
# SHOP_EMAIL_FROM=

# Free products: where the addresses go (a Google Sheet's Apps Script web app)
LEADS_WEBHOOK_URL=
LEADS_TOKEN=
